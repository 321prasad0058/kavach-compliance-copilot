# Kavach API configuration. Copy to api/.env (loaded by `npm start` via node --env-file-if-exists).
# Every variable is optional; defaults are shown.

# ---------------------------------------------------------------- server
PORT=8080
HOST=0.0.0.0
# Angular build to serve (SPA fallback to index.html). Default: ../web/dist/kavach-web/browser
# relative to the api/ directory; the web app is only served when that directory has an index.html.
# WEB_DIST=/app/web/dist/kavach-web/browser
# Comma-separated origins allowed by CORS (the Angular dev server).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---------------------------------------------------------------- backend selection
# auto      -> Snowflake when credentials are configured (SPCS token, PAT or key pair), else offline mock
# snowflake -> Snowflake only (fails fast if credentials are missing)
# mock      -> offline mock over data/out/*.csv (no Snowflake, no LLM; deterministic fallback answers)
KAVACH_BACKEND=auto

# ---------------------------------------------------------------- Snowflake connection (REST, no driver)
# Host without scheme, e.g. xy12345.eu-central-1.snowflakecomputing.com (set automatically inside SPCS).
# Derived from SNOWFLAKE_ACCOUNT when unset.
SNOWFLAKE_HOST=
SNOWFLAKE_WAREHOUSE=KAVACH_WH
SNOWFLAKE_ROLE=KAVACH_APP
# Auth is resolved in this order:
#  1. SPCS: the file at SNOWFLAKE_SPCS_TOKEN_PATH exists (OAuth token, re-read per request)
SNOWFLAKE_SPCS_TOKEN_PATH=/snowflake/session/token
#  2. Programmatic access token
SNOWFLAKE_PAT=
#  3. Key-pair JWT (account locator or org-account; any ".region" suffix is dropped for the JWT claims)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
# ...or the PEM itself (literal "\n" sequences are converted to newlines), e.g. from a secret
SNOWFLAKE_PRIVATE_KEY=
# Only for an encrypted private key
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SQL API statement timeout in seconds (also used for Cortex COMPLETE calls)
KAVACH_SQL_TIMEOUT_S=60

# ---------------------------------------------------------------- Kavach / Cortex
KAVACH_DATABASE=KAVACH
KAVACH_SEMANTIC_MODEL=@KAVACH.APP.SEMANTIC_MODELS/kavach.yaml
# Cortex COMPLETE models, tried in order; the first that works is cached
KAVACH_LLM_MODELS=claude-sonnet-4-5,llama3.1-70b
# Clauses retrieved per question
KAVACH_SEARCH_LIMIT=6
# Top Cortex Search cosine similarity below this -> LOW confidence
KAVACH_SEARCH_MIN_COSINE=0.35

# ---------------------------------------------------------------- offline mock
# Synthetic CSVs (python3 data/generate_synthetic.py) and the semantic model whose verified SQL the mock shows
# KAVACH_DATA_DIR=../data/out
# KAVACH_SEMANTIC_MODEL_PATH=../semantic_model/kavach.yaml
# Artificial per-step latency so the UI's pipeline animation is visible in rehearsal (npm run start:mock uses 300)
KAVACH_MOCK_LATENCY_MS=0
